# ======================================
# Database                             #
# ======================================
DB_HOST=gamecubby-db
DB_PORT=5432
DB_NAME=gamecubby
DB_USER=gamecubby
DB_PASSWORD=gamecubby

# ======================================
# Database Maintenance Role            #
# ======================================
# Used for backup and restore
# Please use a better password but
# ideally no special characters.
MAINT_DB_USER=gc_maint
MAINT_DB_PASSWORD=change-me-strong

# ======================================
# Maintenance/Backups paths            #
# ======================================
# These paths exist inside the containers
# and are bind-mounted from the host
# Don't change unless you know what you are doing
GC_MAINT_FILE=/storage/maintenance.json
GC_BACKUPS_DIR=/storage/backups

# ======================================
# Auto-backup scheduling and Cleanup   #
# ======================================
# This is in UTC
AUTOBACKUPS=yes
CLEAR_MANUAL_BACKUPS=no
BACKUP_RETENTION_DAYS=14
# Never prune the newest N auto backups, even past retention (protects you if backups silently fail for a while)
BACKUP_MIN_KEEP=3
BACKUP_TIME=03:00

# ======================================
# Reverse Proxy (NGINX, HAProxy etc)   #
# ======================================
# PROXY=true: Always secure cookes, use this if you are behind a proxy with SSL.
# If you set that true and access IP:PORT over HTTP your login will not work.
# PROXY=false: Only secure over HTTPS. Use this if you are accessing GC by IP:PORT
PROXY=false

# ======================================
# Web Port                             #
# ======================================
# Change this to access your WebUI via different port.
WEB_PORT=3000

# ======================================
# Load / connection tuning (optional)   #
# ======================================
# Defaults suit a household-sized library; only change these if you know you need to.
# Per API worker: database connections = DB_POOL_SIZE + DB_MAX_OVERFLOW (2 workers by default).
#DB_POOL_SIZE=10
#DB_MAX_OVERFLOW=10
# Seconds a request waits for a free DB connection before the API answers 503 (Retry-After).
#DB_POOL_TIMEOUT=10
# Any single SQL statement is cancelled after this many milliseconds (0 = no limit).
#DB_STATEMENT_TIMEOUT_MS=30000
# Request threads per worker. Keep it BELOW pool size + overflow (default: that minus 4).
#THREADPOOL_SIZE=16
# Concurrent connections per worker before extra ones get an immediate 503.
#LIMIT_CONCURRENCY=80
